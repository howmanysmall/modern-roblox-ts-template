	"organizeImports": {
		"enabled": true,
		"ignore": ["**/node_modules/**", "**/out/**", "**/include/**"],
		"include": ["**/*.ts", "**/*.js"]
	},

	"overrides": [
		{
			"include": [".vscode/**", "*.code-workspace", "tsconfig.json"],
			"ignore": ["garbage/**"],
			"json": {
				"formatter": {
					"enabled": true,
					"indentStyle": "tab",
					"indentWidth": 4,
					"lineWidth": 120,
					"trailingCommas": "all"
				},
				"linter": { "enabled": true },
				"parser": {
					"allowComments": true,
					"allowTrailingCommas": true
				}
			}
		}

		// {
		// 	"include": [".vscode/**", "*.code-workspace", "tsconfig.json"],
