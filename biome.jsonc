		// 			"lineEnding": "lf",
		// 			"lineWidth": 120,
		// 			"trailingCommas": "all"
		// 		},
		// 		"linter": { "enabled": true }
		// 	}
		// }
	],

	"vcs": {
		"clientKind": "git",
		"defaultBranch": "main",
		"enabled": true,
		"useIgnoreFile": true
	}
}
